# BandRoom configuration (SPEC §19.5). Copy to deploy/.env on the server; never commit .env.

# --- Core ---
# Public URL. A path component (https://example.com/your-secret-path) makes the app mount under it.
APP_URL=https://bandroom.example.com
APP_NAME=BandRoom
# At least 32 random bytes, e.g.: openssl rand -base64 48
APP_SECRET=
LOG_LEVEL=info
DEFAULT_LOCALE=en

# Caddy site address (hostname only), used by compose for HTTPS certificates.
SITE_ADDRESS=bandroom.example.com
# Sub-path variant only (Caddyfile.subpath): the path of APP_URL, e.g. /your-secret-path.
# BASE_PATH=
# Host user/group that owns ./data; the app and worker containers run as it (host-setup.md §5).
BANDROOM_UID=1000
BANDROOM_GID=1000
# Image tag to run (vX.Y.Z or latest); `sudo ./deploy.sh vX.Y.Z` sets it (host-setup.md §7).
BANDROOM_TAG=latest

# --- Limits ---
MAX_UPLOAD_BYTES=2147483648
WORKER_CONCURRENCY=1
# Seconds before the files of "Delete permanently" / "Empty Trash" are deleted (default 600).
# PURGE_GC_GRACE_SECONDS=600

# --- Internal (worker -> API job events) ---
# Required. openssl rand -base64 48
INTERNAL_EVENTS_SECRET=

# --- Storage (M15) ---
# STORAGE_BACKEND=local
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_PREFIX=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- Optional ---
# GEOIP_DB_PATH=
