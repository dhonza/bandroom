{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATA_DIR=${DATA_DIR:-../../.data} tsx watch --env-file-if-exists=../../.env src/main.ts | pino-pretty",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bandroom/server-core": "workspace:*",
    "@bandroom/shared": "workspace:*",
    "@node-rs/argon2": "2.2.1",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "midi-file": "1.2.4",
    "pino": "10.3.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "13.1.3",
    "tsdown": "0.23.0",
    "tsx": "4.23.15"
  }
}
